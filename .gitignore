# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
*.spec
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# --- Attune data & artifacts (NEVER commit personal library data) ---
data/
*.db
*.db-wal
*.db-shm
*.sqlite
validation_paths.txt
validation_report.json
lastfm_resolution_report.json

# Captured MusicIP output / ground truth = derived from your personal library. Private.
groundtruth/
**/groundtruth/
library.json
library_extended.txt
*.m3lib
*.m3lib.snapshot
*.m3usr

# MusicIP / third-party proprietary binaries — must never be redistributed here
MusicMagic*.exe
mipcore.exe
genpuid*
*.pem
register.key
*register.key

# Bundled ffmpeg/ffprobe binaries (GPLv3) staged for the frozen build. Redistributed
# with the built app as separate programs (see NOTICE.md), NOT committed to this MIT
# repo — they are large (~282 MB) and license-incompatible with the tree. build.py
# add-datas them from here if present; a public build fetches its own copy.
desktop/ffbin/

# --- OS / editor ---
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp

# demo library (regenerate with examples/make_demo_library.py)
examples/sample_library/

# bridge personal config + outputs
bridge/config.json
bridge/playlists/

# secrets / local env — NEVER commit (Plex token, Last.fm key, etc.)
.env
*.env
!*.env.example

# machine-specific personal strings for tools/leak_check.py (checked locally, never published)
.leakpatterns

# MAD-loop scratch (adversarial review staging)
.mad/

# blind ear-test session artifacts (eval/abtest.py): sealed keys + operator verdicts.
# Per-session, and they carry personal library paths -- local only.
eval/abtest_key_*.json
eval/abtest_results.jsonl

# mined behavioural pairs (eval/build_behavior_pairs.py --emit-pairs): ~6 MB, carries the
# full personal library path list, and regenerates in seconds. The small result JSONs next
# to it (behavior_probe_result / behavior_signal_probe) ARE committed -- they are the
# evidence behind eval/SIGNAL_REPORT.md, and they are published with folder paths and
# playlist names replaced by placeholders (each says so in its own "_sanitized" field).
eval/behavior_pairs.json

# generated eval result dumps. eval/harness.py and friends write the analyzed library's real
# file names into these, which is personal data however innocuous the filename looks. They
# regenerate from the scripts in eval/ and are never worth committing. (The one tracked
# recipe_sweep file predates this rule and was checked: it holds parameters and scores only.)
eval/report_*.json
eval/compare_clap_alone_*.json
eval/recipe_sweep_*.json

# the CLAP audio model is 263 MiB. Keeping it in the repo made every clone pay for it, needed
# the git-lfs add-on to get anything but a 134-byte stub, and drew on a shared monthly
# bandwidth allowance. It is published as a release asset instead:
#     python tools/fetch_model.py
src/models/clap_music.onnx

# swap log written beside the built app by the desktop build road
dist-swap.log

# git worktrees the desktop app creates for parallel sessions
.claude/worktrees/
